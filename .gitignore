# --- 내려받은 원문 -----------------------------------------------------------
# 재현 시 scripts/prepare_sources.py 로 다시 받아 해시를 대조한다.
# data/manifest.json 은 해시·분량 기록이므로 커밋한다.
data/raw/

# --- 인덱스 / 중간 산출물 ----------------------------------------------------
data/chunks/
data/index/
*.faiss
*.pkl
# 모델·임베딩 캐시 (HuggingFace, CacheBackedEmbeddings)
.cache/
models/
# R3: 실제 실행 원문은 실행 저장소에 보관한다. 합성 증빙만 docs/evidence/r3 에 커밋한다.
/runs/

# --- 비밀 ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem

# --- 생성 산출물 --------------------------------------------------------------
# 제출본은 예외적으로 강제 추가한다:  git add -f output/RAG-Output_*.pdf
output/*.md
output/*.pdf
output/*.jsonl
*.log

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/
.coverage
htmlcov/
# uv.lock 은 재현성을 위해 커밋한다 — 무시하지 않는다.

# --- 도구 / 에디터 -----------------------------------------------------------
.ruff_cache/
.mypy_cache/
.pytest_cache/
.vscode/
.idea/
*.swp
.claude/settings.local.json

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db
